{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "ES2021", "ES2022", "DOM"],
    "outDir": "./public",
    "rootDir": "./src",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "strict": false,
    "paths": {
      "@core/*": ["./src/@core/*"],
      "app/*": ["./src/app/*"],
      "@db/*": ["./src/@db/*"],
      "@om/*": ["./src/@om/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "public"]
}