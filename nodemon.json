{
    "watch": ["src"],
    "ext": "ts",
    "ignore": ["**/*.test.ts", "**/*.spec.ts", ".git", "node_modules", "public"],
    "exec": "node -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "env": {
      "NODE_ENV": "development"
  },
    "delay": 1000,
    "events": {
      "restart": "echo '🔄 Reiniciando servidor...'"
    }
  }